# Blockchain / Besu Configuration
RPC_URL=http://localhost:8545
CHAIN_ID=1337

# Deployed Contract Addresses
SETTLEMENT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DIRECTORY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Database Configuration (PostgreSQL / Neon)
# Note: CONTROL_PLANE_DATABASE_URL sets ?schema=control_plane
CONTROL_PLANE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clear_db?schema=control_plane"
# Note: TENANT_DATABASE_URL_BASE is suffixed with ?schema=registry_<id> at runtime
TENANT_DATABASE_URL_BASE="postgresql://postgres:postgres@localhost:5432/clear_db"

# Security & Cryptography
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
# 32-byte hex key for AES-256-GCM signer key encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Strategy Modes
VERIFICATION_MODE=auto-approve
# Set true only for local fixtures that skip the council UI
AUTO_APPROVE_ON_CHAIN=false
SIGNER_CUSTODY_MODE=app-encrypted
CREDIT_REFERENCE_MODE=local-hash

# Council portal (gov login)
COUNCIL_EMAIL=council@clear-ledger.org
COUNCIL_PASSWORD=council-secret-pass

# Optional production custody / reference
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=clear-signer
# SELF_CUSTODY_ADDRESS=
# SELF_CUSTODY_WEBHOOK_URL=
# SELF_CUSTODY_CONFIG=
# CAD_TRUST_API_URL=

# Safe council (testnet/mainnet)
# SAFE_OWNERS=0xabc...,0xdef...
# SAFE_THRESHOLD=2
