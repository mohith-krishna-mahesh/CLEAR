{
  "name": "@clear/registry-hub",
  "version": "0.1.0",
  "description": "Multi-tenant registry hub service for CLEAR protocol",
  "license": "Apache-2.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate --schema=src/db/control-plane/schema.prisma && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "prisma generate --schema=src/db/control-plane/schema.prisma && vitest run",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "prisma:generate": "prisma generate --schema=src/db/control-plane/schema.prisma",
    "seed:demo": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@clear/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.12.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
